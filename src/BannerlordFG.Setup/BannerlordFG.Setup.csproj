    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{ED1B8640-53BA-46FA-9B7D-667D56F62F3E}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>BannerlordFG.Setup</RootNamespace>
    <AssemblyName>BannerlordFG.Maintenance</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <OutputPath>..\..\Module\BannerlordFG\bin\Win64_Shipping_Client\</OutputPath>
    <WarningLevel>4</WarningLevel>
