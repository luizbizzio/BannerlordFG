  <!-- net472 resolves SharpCompress through its netstandard2.0 asset. MSBuild /restore
       must copy SharpCompress and its transitive runtime assemblies to OutputPath. -->
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <!-- This package's net461 DLL has CLR assembly version 4.2.0.1, required by Bcl.AsyncInterfaces 8. -->
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <!-- Explicit .NET Framework runtime dependencies for the DLL-only PowerShell host.
         System.Memory 4.6.0 supplies assembly version 4.0.2.0 required by SharpCompress. -->
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Buffers" Version="4.6.0" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.0" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
